{
  "name": "powerdevbox-admin",
  "version": "0.7.9",
  "description": "Local Power DevBox Admin Center for Power Platform and Dataverse administration.",
  "license": "MIT",
  "homepage": "https://github.com/wyattdave/pdac#readme",
  "bugs": {
    "url": "https://github.com/wyattdave/pdac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyattdave/pdac.git"
  },
  "type": "module",
  "bin": {
    "powerdevbox-admin": "server.mjs",
    "pdac": "server.mjs"
  },
  "files": [
    "server.mjs",
    "chrome-ext/src/solution-access.js",
    "chrome-ext/src/table-data-api.js",
    "chrome-ext/table-data.js",
    "chrome-ext/table-data.css",
    "public",
    "icon.png",
    "favicon.png",
    "scripts",
    "docs/platform-parity.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test testing/*.test.mjs chrome-ext/testing/*.test.mjs",
    "sync:platforms": "node scripts/sync-platforms.mjs",
    "check:parity": "node scripts/sync-platforms.mjs --check",
    "install-startup": "node scripts/background-manager.mjs install",
    "remove-startup": "node scripts/background-manager.mjs uninstall"
  },
  "dependencies": {
    "@microsoft/power-apps-actions": "^1.5.5",
    "@microsoft/power-apps-cli": "^0.11.6",
    "@microsoft/power-apps-common": "^1.1.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1"
  },
  "overrides": {
    "uuid": "11.1.1",
    "archiver": "8.0.0",
    "fast-csv": "5.0.5",
    "unzipper": "0.12.3"
  }
}
