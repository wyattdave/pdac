{
  "manifest_version": 3,
  "name": "PDAC - Power DevBox Admin Center",
  "version": "0.6.15",
  "description": "Power Platform admin reports and administration, running entirely in your browser. No server, no install.",
  "minimum_chrome_version": "114",
  "action": {
    "default_title": "Open PDAC"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://*.dynamics.com/*",
    "https://api.powerapps.com/*",
    "https://api.bap.microsoft.com/*",
    "https://api.powerplatform.com/*"
  ],
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
